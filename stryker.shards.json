[
  {
    "id": "core",
    "workspace": "packages/core",
    "runner": "vitest",
    "mutate": ["packages/core/src/**/*.{ts,tsx}"],
    "canary": "packages/core/src/domain/auditorium.ts",
    "report": "reports/mutation/core.json"
  },
  {
    "id": "client",
    "workspace": "packages/client",
    "runner": "vitest",
    "mutate": ["packages/client/src/**/*.{ts,tsx}"],
    "canary": "packages/client/src/verify.ts",
    "report": "reports/mutation/client.json"
  },
  {
    "id": "view-logic",
    "workspace": "packages/view-logic",
