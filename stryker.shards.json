  {
    "id": "native-shell",
    "workspace": "apps/native",
    "runner": "jest",
    "jest": "apps/native/jest.config.js",
    "coverageAnalysis": "perTest",
    "mutate": ["apps/native/src/{app,host,hand-off,ledger,room}/**/*.{ts,tsx}"],
    "mutantsPerJob": 6,
    "canary": "apps/native/src/host/profile.ts",
