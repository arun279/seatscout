    "mutantsPerJob": 8,
    "canary": "apps/native/src/design-system/banner.tsx",
    "report": "reports/mutation/native-design-system.json"
  },
  {
    "id": "native-search",
    "workspace": "apps/native",
    "runner": "jest",
    "jest": "apps/native/jest.config.js",
    "coverageAnalysis": "perTest",
    "mutate": ["apps/native/src/search/**/*.{ts,tsx}"],
