{
  "name": "seatscout",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build --pretty false && pnpm --filter @seatscout/web build",
    "claims": "node tools/claims-in-prose.mjs",
    "complexity": "oxlint",
    "contract:alarm": "node tools/contract-alarm.mjs",
    "corpus:refresh": "node tools/capture-corpus.mjs && node tools/corpus-index.mjs && biome format --write packages/core/src/corpus/captures.ts",
    "counts": "node tools/counts-in-prose/src/index.ts",
    "dead-code": "knip",
    "duplication": "jscpd apps/*/src packages/*/src tools/*/src && node tools/no-empty-run/src/index.ts duplication",
    "footprint": "node tools/footprint/dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icons": "node tools/app-icon.mjs",
    "journey": "node tools/journey/src/index.ts",
    "lint": "biome lint .",
    "prepare": "lefthook install && git worktree prune",
    "reassure": "pnpm --filter @seatscout/native exec reassure",
    "spell": "cspell lint --dot .",
    "test:e2e": "playwright test --list --grep @accessibility && playwright test --grep-invert @performance",
    "test:journey": "playwright test --list --grep @performance && playwright test --grep @performance --workers=1",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:mutation": "VITEST_MAX_WORKERS=1 stryker run && node tools/no-empty-run/src/index.ts mutation",
    "test:mutation:incremental": "VITEST_MAX_WORKERS=1 stryker run --incremental && node tools/no-empty-run/src/index.ts mutation",
    "test:mutation:native": "stryker run stryker.native.config.json && node tools/no-empty-run/src/index.ts mutation reports/mutation/native.json",
    "test:mutation:native:incremental": "stryker run stryker.native.config.json --incremental && node tools/no-empty-run/src/index.ts mutation reports/mutation/native.json",
    "test:native": "jest --config apps/native/jest.config.js --ci",
    "test:unit": "vitest run",
    "typecheck": "tsc --build --pretty false --noEmit",
    "versions": "syncpack lint"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@seatscout/core": "workspace:*",
    "@size-limit/file": "13.0.3",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.1",
    "cspell": "10.3.2",
    "jest": "29.7.0",
    "jscpd": "5.2.1",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "lefthook": "2.1.14",
    "oxlint": "1.83.0",
    "size-limit": "13.0.3",
    "syncpack": "15.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "web-vitals": "6.2.2"
  }
}
