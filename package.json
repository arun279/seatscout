{
  "name": "seatscout",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build --pretty false",
    "claims": "node tools/claims-in-prose.mjs",
    "complexity": "oxlint",
    "contract:alarm": "node tools/contract-alarm.mjs",
    "corpus:refresh": "node tools/capture-corpus.mjs",
    "counts": "node tools/counts-in-prose/src/index.ts",
    "dead-code": "knip",
    "duplication": "jscpd apps/*/src packages/*/src tools/*/src && node tools/no-empty-run/src/index.ts duplication",
    "footprint": "node tools/footprint/dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "lefthook install && git worktree prune",
    "reassure": "pnpm --filter @seatscout/native exec reassure",
    "spell": "cspell lint --dot .",
    "test:e2e": "playwright test --list --grep @accessibility && playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:mutation": "VITEST_MAX_WORKERS=1 node tools/mutation.mjs",
    "test:native": "jest --config apps/native/jest.config.js --ci",
    "test:unit": "vitest run",
    "typecheck": "tsc --build --pretty false --noEmit",
    "versions": "syncpack lint"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@seatscout/core": "workspace:*",
    "@size-limit/file": "14.1.0",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "cspell": "10.3.6",
    "jest": "29.7.0",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "oxlint": "1.86.0",
    "serve": "14.2.6",
    "size-limit": "14.1.0",
    "syncpack": "15.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
