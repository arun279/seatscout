{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "extends": ["./biome.json"],
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 1 }
        }
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 1 }
        }
      }
    }
  }
}
