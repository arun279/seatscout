{
  "$schema": "https://unpkg.com/@cspell/cspell-types@10.1.1/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "ignorePaths": [
    ".git",
    "cspell.json",
    "pnpm-lock.yaml",
    "packages/core/src/corpus/**/*.json",
    "packages/core/src/corpus/captures.ts"
  ],
  "flagWords": ["ts-nocheck"],
  "overrides": [
    {
      "filename": [
        "tools/lint/*.grit",
        "tools/claims-in-prose.pairs.gates.mjs",
        "tools/planted-red/planted/colours/*"
