{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**",
                      "cloudflare:*",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "react-native",
                      "react-native/**",
                      "react-native-*",
                      "expo",
                      "expo/**",
                      "expo-*"
                    ],
                    "message": "packages/core stays platform free: no DOM, React, React Native, or runtime specific imports. See docs/adr/0003-separate-view-layers-shared-core.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
