    "@react-native-community/slider": "5.2.1",
    "@seatscout/client": "workspace:*",
    "@seatscout/view-logic": "workspace:*",
    "expo": "57.0.24",
    "expo-constants": "57.0.19",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.10",
    "expo-network": "57.0.2",
    "expo-router": "57.0.22",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.23",
    "react": "19.2.3",
