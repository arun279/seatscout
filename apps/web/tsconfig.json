{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "src",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/worker",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.fixtures.ts",
    "src/**/*.fixtures.tsx"
  ]
}
