language js

pattern imported_from_this_repository($name) {
  JsImport() as $import where {
    $import <: contains `"$source"` where { $source <: r"\.\.?/.*" },
    $import <: contains $name
  }
}

pattern a_function() {
  or {
    JsArrowFunctionExpression(),
    JsFunctionDeclaration(),
    JsFunctionExpression(),
    JsMethodObjectMember(),
    JsMethodClassMember(),
    JsGetterObjectMember(),
    JsGetterClassMember(),
    JsSetterObjectMember(),
    JsSetterClassMember(),
    JsConstructorClassMember()
  }
}

pattern a_describe_body() {
  $body where {
    $body <: within or {
      `describe($_, $body)`,
      `describe.skip($_, $body)`,
      `describe.only($_, $body)`,
      `describe.each($_)($_, $body)`
    }
  }
}

JsCallExpression(callee=$callee) as $call where {
  $call <: not within a_function() as $function where {
    $function <: not a_describe_body()
  },
  $callee <: or {
    JsIdentifierExpression() as $name,
    JsStaticMemberExpression(object=JsIdentifierExpression() as $name)
  },
  $call <: within JsModule() as $module,
  $module <: contains imported_from_this_repository($name),
  register_diagnostic(span=$call, message="This call runs while the test file loads, at its top level or in a describe body. A mutant that breaks it stops the whole file from loading, which Stryker scores as a runtime error rather than a kill. Make the call inside each test, or keep the value as plain data.")
}
