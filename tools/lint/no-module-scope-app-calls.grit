language js

pattern imported_from_this_repository($name) {
  JsImport() as $import where {
    $import <: contains `"$source"` where { $source <: r"\.\.?/.*" },
    $import <: contains $name
  }
}

JsCallExpression(callee=$callee) as $call where {
  $call <: not within or {
    JsArrowFunctionExpression(),
    JsFunctionDeclaration(),
    JsFunctionExpression()
  },
  $callee <: or {
    JsIdentifierExpression() as $name,
    JsStaticMemberExpression(object=JsIdentifierExpression() as $name)
  },
  $call <: within JsModule() as $module,
  $module <: contains imported_from_this_repository($name),
  register_diagnostic(span=$call, message="This call runs while the test file loads. A mutant that breaks it stops the whole file from loading, which Stryker scores as a runtime error rather than a kill. Make the call inside each test, or keep the value as plain data.")
}
