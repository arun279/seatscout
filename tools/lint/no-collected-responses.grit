language js

pattern transport_call() {
  or {
    `fetch($...)`,
    `$_.fetch($...)`,
    `fetch`,
    `$_.fetch`
  }
}

pattern reader() {
  or {
    `text`,
    `json`,
    `arrayBuffer`,
    `blob`,
    `bytes`,
    `formData`
  }
}

pattern body_read($receiver) {
  or {
    `$receiver.$reader($...)` where { $reader <: reader() },
    `$receiver?.text($...)`,
    `$receiver?.json($...)`,
    `$receiver?.arrayBuffer($...)`,
    `$receiver?.blob($...)`,
    `$receiver?.bytes($...)`,
    `$receiver?.formData($...)`
  }
}

pattern reads_its_own_argument() {
  or {
    `($response) => $rest`,
    `async ($response) => $rest`
  } where { $rest <: contains body_read($response) }
}

or {
  `$_.map($callback)`,
  `$_.flatMap($callback)`,
  `$_?.map($callback)`,
  `$_?.flatMap($callback)`
} where {
  or {
    and {
      $callback <: contains transport_call(),
      ! $callback <: contains body_read($_)
    },
    $callback <: reads_its_own_argument()
  },
  register_diagnostic(span=$callback, message="Read each response body where its response arrives. Collecting responses across a fan-out and reading their bodies afterwards holds every connection open and can stall. CONTRIBUTING.md says what to write instead.")
}
