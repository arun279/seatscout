  },
  {
    "name": "app for Android, Hermes bytecode",
    "path": "apps/native/dist/_expo/static/js/android/*.hbc",
    "limit": "1 B"
  },
  {
    "name": "app for the web",
    "path": "apps/native/dist/_expo/static/js/web/*.js",
    "limit": "1 B"
  },
  {
    "name": "app's faces and images",
    "path": "apps/native/dist/assets/**/*",
    "limit": "1 B"
  }
]
