[
  {
    "name": "web app",
    "path": "apps/web/dist/**/*.js",
    "limit": "78969 B"
  },
  {
    "name": "stylesheets",
    "path": "apps/web/dist/**/*.css",
    "limit": "4188 B"
  },
  {
    "name": "fonts",
    "path": "apps/web/dist/fonts/*.woff2",
    "limit": "118924 B"
  },
  {
    "name": "icons",
    "path": [
      "apps/web/dist/*.png",
      "apps/web/dist/*.ico",
      "apps/web/dist/*.svg"
    ],
    "limit": "134269 B"
  },
  {
    "name": "app for iOS, Hermes bytecode",
    "path": "apps/native/dist/_expo/static/js/ios/*.hbc",
