{
  "$schema": "https://unpkg.com/knip@6.32.3/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["lychee"],
  "ignoreDependencies": ["serve"],
  "workspaces": {
    ".": {
      "vitest": {
        "config": [
          "vitest.config.ts",
          "vitest.live.config.ts",
          "vitest.stryker.config.ts"
        ]
      }
    },
    "apps/native": {
      "entry": ["src/app/**/*.tsx", "test/**/*.perf-test.tsx"],
      "expo": {
        "entry": ["plugins/*.ts"]
      },
      "jest": {
        "config": ["jest.config.js", "jest.perf.config.js"]
      }
    }
  }
}
